# Maintainer: William C. Canin
pkgname=argvus-display
pkgver=0.1.0
pkgrel=1
pkgdesc="Display and monitor layout integration for the ARGVUS desktop"
arch=('any')
url="https://github.com/argvus/argvus-display"
license=('GPL-3.0-only')
depends=(
  'argvus-i18n'
  'argvus-session'
  'hyprland'
  'nwg-displays'
  'python'
)
optdepends=(
  'libnotify: desktop notification after applying an nwg-displays layout'
)
options=('!debug')
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_display_payload
}

package() {
  arch_package_display_payload
}
